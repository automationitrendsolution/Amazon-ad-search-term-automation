# ---------------------------------------------------------------------------
# search_term_Automation report -> gen_ai_db.searchtermreport
#
#   cp .env.example .env && chmod 600 .env
#
# .env holds secrets: never commit it. Exported environment variables take
# precedence over values in this file.
# ---------------------------------------------------------------------------

# --- MySQL (destination is fixed: gen_ai_db.searchtermreport) ----------
DB_HOST=65.1.76.109
DB_PORT=3306
# Must be gen_ai_db; any other value is refused.
DB_NAME=gen_ai_db
# A login with SELECT, INSERT, UPDATE, DELETE on gen_ai_db.searchtermreport
# (see sql/grant_access.sql; CREATE too for the one-time --create-table).
DB_USER=gen_ai
DB_PASSWORD=itrendgenai@1234
# DB_SSL_CA=certs/ca.pem
DB_SSL_VERIFY_CERT=false
DB_SSL_DISABLED=false
DB_CONNECT_TIMEOUT_SECONDS=30
# Rows per INSERT statement.
DB_INSERT_CHUNK_SIZE=2000
# How the downloaded rows are written (one transaction either way; a single
# run can override it with --load-mode):
#   replace - delete each date+marketplace in the file, then insert its rows
#   upsert  - insert new rows, update rows already in the table (same date,
#             hour, marketplace, campaign, ad group, target and search term)
#   insert  - insert new rows only; rows already in the table stay unchanged
# upsert / insert match rows on the row_key column: a table created before it
# existed needs sql/migrate_add_row_key.sql run once by an admin.
DB_LOAD_MODE=upsert
# upsert / insert only: commit every this many rows, so a big file (a week is
# ~1.35 million rows) survives a dropped connection and a re-run continues
# where it stopped. 0 = the whole file in one transaction. replace is always
# one transaction.
DB_COMMIT_EVERY_ROWS=50000

# --- Dates -------------------------------------------------------------------
# The browser's timezone, and the calendar "today" is judged in. Use the
# westernmost marketplace in the report (US / CA accounts report in
# America/Los_Angeles), so no account's day is still running when it has ended.
AMAZON_ACCOUNT_TIMEZONE=America/Los_Angeles
# Your own timezone; only used to show local time in the logs.
REPORT_TIMEZONE=Asia/Kolkata
# Refuse files with rows older than this many days (8 allows "Last week").
MAX_REPORT_AGE_DAYS=8

# --- Report IDs --------------------------------------------------------------
# The saved report "search_term_Automation" in Amazon Ads > Reporting
# (Search term, Hourly, CSV). Set its report period to "Today" so every hourly
# run downloads only the day in progress. Click the report name and copy the
# reportId=... value from the browser's address bar.
REPORT_ID_TODAY=00000000-0000-0000-0000-000000000001
# Optional: a second saved copy of the same report with period "Yesterday".
# When set, it also runs in the first YESTERDAY_FINALIZE_HOURS hours of the
# day (00:00-02:00 Los Angeles = 12:45 and 13:45 IST runs) to complete the day
# that just ended (its last hour and late-arriving sales).
# REPORT_ID_YESTERDAY=00000000-0000-0000-0000-000000000002
YESTERDAY_FINALIZE_HOURS=2
# true = download the newest finished run of the report ("Download latest" in
# Amazon) instead of clicking Run and waiting. Its rows are loaded whatever
# period the run covered (MAX_REPORT_AGE_DAYS is not applied). Same as --latest.
DOWNLOAD_LATEST=false
# Optional: text the report page must show, to catch a swapped ID.
REPORT_NAME_TODAY=search_term_Automation
# REPORT_NAME_YESTERDAY=search_term_Automation_Yesterday
# Leave unset for an "All accounts" report (the console opens with
# ephemeralAdvertiser=true on advertising.amazon.de). Set it only if the
# report belongs to one advertiser account (the entityId=... value in its URL).
# AMAZON_ENTITY_ID=ENTITYXXXXXXXXXXXX
# Optional override; {report_id} (and {entity_id}) are filled in.
# REPORT_HISTORY_URL_TEMPLATE=https://advertising.amazon.de/reporting/history?reportId={report_id}&ephemeralAdvertiser=true

# --- Amazon sign-in ----------------------------------------------------------
# The saved browser session (SESSION_DIR) is the primary mechanism. These are
# only used when it has expired. CAPTCHA/OTP/MFA always stop the run for a
# person (python run.py --login). Set both or neither.
AMAZON_EMAIL=babu.n@itrendsolution.com
AMAZON_PASSWORD=Babu@2026
AMAZON_AUTO_LOGIN=true

# --- Files -------------------------------------------------------------------
# Leave unset to auto-detect; set when Amazon's Date column uses another format.
# CSV_DATE_FORMAT=%b %d, %Y
REPORTS_DIR=data/reports
DOWNLOAD_DIR=data/downloads
ARCHIVE_DIR=data/archive
FAILED_DIR=data/failed
SCREENSHOT_DIR=data/screenshots
LOG_DIR=logs
# Chromium profile with the Amazon session. Treat it as a credential.
# Its own session: never share the targeting job's data/session folder.
SESSION_DIR=data/session
LOCK_FILE=data/search_term_automation.lock

# --- Browser and waiting -----------------------------------------------------
HEADLESS=true
# Keep the browser's identity identical for --login and the scheduled runs,
# or Amazon asks for two-step verification again. Use the headed string for
# this machine's OS and Chromium major version, e.g. on Linux:
# BROWSER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36
BROWSER_TIMEOUT_MS=60000
# A full day across all marketplaces is ~200,000 rows (~60 MB).
DOWNLOAD_TIMEOUT_MS=300000
# How long a report run may stay at '-' before the attempt is abandoned, and
# how often the history page is reloaded meanwhile.
REPORT_READY_TIMEOUT_SECONDS=900
REPORT_POLL_INTERVAL_SECONDS=30
BROWSER_NO_SANDBOX=false

# --- Retry -------------------------------------------------------------------
# Transient failures only (navigation, download, report not ready, lost DB
# connection). Authentication is never retried. Keep
# MAX_RETRIES x REPORT_READY_TIMEOUT_SECONDS under an hour.
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=10
RETRY_BACKOFF_MAX_SECONDS=120

# --- Logging and housekeeping --------------------------------------------------
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
# Age at which the app deletes its OWN downloads, archives and screenshots.
FILE_RETENTION_DAYS=3
